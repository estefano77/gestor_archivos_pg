# =============================================================================
# CloudVault · versión PostgreSQL / Supabase
# =============================================================================
# Copia este archivo a `.env.local` y rellena los valores. NO copies el archivo
# tal cual a `.env.local`: el repositorio es público y cualquier secreto que
# quede en él queda comprometido.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de datos
# -----------------------------------------------------------------------------
# Cadena de conexión de PostgreSQL.
#
# EN SUPABASE (producción): copia la que da el panel, en Project Settings >
# Database > Connection string, y **no la edites**. Cópiala tal cual, con su
# contraseña y con su `?sslmode=require` si lo trae.
#
#   postgresql://postgres.REF:PASSWORD@aws-1-REGION.pooler.supabase.com:PUERTO/postgres
#
# Tres cosas que fallan a menudo, y ninguna es culpa del proyecto:
#   · el prefijo del host puede ser `aws-0-` o `aws-1-`, depende del proyecto
#   · el usuario lleva el ref detrás: `postgres.REF`, no `postgres` a solas.
#     Con el usuario equivocado el pooler dice `tenant/user ... not found`
#   · el puerto puede ser 5432 o 6543 según el modo
#
# Lo de verdad importante es no usar la conexión directa si el panel ofrece el
# pooler: las funciones serverless abren y cierran conexiones constantemente y la
# directa se agota enseguida, con errores de "too many clients".
#
# EN LOCAL: la de tu PostgreSQL instalado.
#
# Sobre el TLS: no hay nada que configurar. Si el host es `localhost` o
# `127.0.0.1` la aplicación no lo pide; con cualquier otro host lo usa. Si
# algún día necesitas forzarlo, esta variable manda sobre lo anterior:
#   PGSSLMODE=disable   no usarlo nunca
#   PGSSLMODE=require   verificar el certificado
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/gestor_archivos_pg

# -----------------------------------------------------------------------------
# Almacenamiento de los archivos
# -----------------------------------------------------------------------------
# `local` guarda los binarios en la carpeta `.storage/` del proyecto. Es lo
# adecuado para desarrollo y **no sirve en Vercel**, donde el disco de una
# función es efímero y los archivos se perderían.
#
# `supabase` los sube a Supabase Storage. Es lo que hay que usar en producción.
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage

# Solo hacen falta con STORAGE_BACKEND=supabase.
#
# La URL del proyecto. Esta sí es pública y por eso lleva el prefijo
# NEXT_PUBLIC_; no da acceso a nada por sí sola.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# El bucket donde se guardan los archivos. Créalo como **privado**: el control de
# acceso lo hacen las rutas de API, no el bucket.
SUPABASE_STORAGE_BUCKET=archivos

# Clave de servicio. **Nunca sale del servidor** y por eso NO lleva el prefijo
# NEXT_PUBLIC_. Con esta clave se ignoran las políticas de RLS, así que solo
# debe leerla el servidor. Si alguna vez llega al navegador, quien la tenga puede
# leer y escribir en tu base de datos entera.
#
# Ojo con el prefijo: Next.js sustituye las variables NEXT_PUBLIC_* por su valor
# en tiempo de compilación, DENTRO del código que se descarga el navegador. No es
# una convención: es una entrega. Con la service role ahí, cualquier visitante
# se llevaría la base de datos entera.
#
# Supabase > Project Settings > API > service_role > Reveal.
SUPABASE_SERVICE_ROLE_KEY=pega_aqui_la_service_role_key

# NO hay clave anónima en este archivo, y es a propósito.
#
# Esta aplicación no usa la autenticación de Supabase: las cuentas están en la
# tabla `users` de este proyecto, con la contraseña hasheada con bcrypt, y la
# sesión es un JWT propio firmado con JWT_SECRET. Supabase Auth (GoTrue) no
# interviene. Por eso la clave anon no hace falta para nada, ni siquiera para
# restablecer contraseñas: el correo de Supabase iría a auth.users, una tabla
# que aquí no se escribe. Si algún día alguien olvida su contraseña, hay que
# establecersela desde fuera.

# -----------------------------------------------------------------------------
# Sesión
# -----------------------------------------------------------------------------
# Secreto para firmar los tokens de sesión JWT (mínimo 32 caracteres).
#
# IMPORTANTE: no copies el valor de este archivo a tu .env.local. Este repositorio
# es público, así que cualquier valor que pongas aquí queda comprometido y
# permitiría a un tercero falsificar sesiones y acceder a los archivos de
# cualquier usuario. Genera uno propio con:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Esta aplicación es independiente de la que usa MongoDB: usa un secreto
# DISTINTO, o una sesión abierta en una serviría en la otra.
JWT_SECRET=pega_aqui_un_secreto_aleatorio_de_32_caracteres_o_mas

# -----------------------------------------------------------------------------
# Nombre público de la aplicación
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="CloudVault - Gestor de Archivos"

# -----------------------------------------------------------------------------
# Método de acceso a la aplicación
# -----------------------------------------------------------------------------
# Un solo número lo decide todo:
#   0 = solo cuenta local (correo y contraseña)
#   1 = solo cuenta de Google
#   2 = ambas modalidades
#
# El ajuste se aplica de verdad, no solo ocultando botones: en modo 0 las rutas
# /api/auth/google y /api/auth/google/callback responden 403, y en modo 1 lo
# hacen /api/auth/login y /api/auth/register.
#
# Si no se define la variable se asume 0, el modo más restrictivo. Un valor que
# no sea 0, 1 o 2 hace fallar la aplicación en lugar de elegir uno por defecto:
# si escribieras 3 queriendo restringir el acceso y la app cayera en "ambas
# modalidades", quedaría expuesto un método que creías cerrado.
NEXT_PUBLIC_AUTH_MODE=0

# -----------------------------------------------------------------------------
# Credenciales de Google
# -----------------------------------------------------------------------------
# Google Cloud Console > APIs y Servicios > Credenciales > Crear credenciales >
# ID de cliente OAuth > Aplicación web.
#
# Solo hacen falta si usas el modo 1 o el 2. El Client Secret se usa solo en el
# servidor y nunca se expone al navegador.
#
# Puedes **reutilizar el mismo cliente OAuth** que la versión con MongoDB y
# simplemente añade una segunda URI de redirección. Es lo que recomienda este
# proyecto: evita una segunda pantalla de consentimiento y un secreto más que
# gestionar.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# URI de redirección de Google. Recomendada en producción.
#
# Google exige que la URI registrada en su consola coincida carácter por carácter
# con la que envía la aplicación. Si se deja vacía, la aplicación la deduce de la
# dirección con la que el usuario entró, y eso se rompe en cuanto hay más de una
# puerta de entrada: un dominio propio, el alias de Vercel, "www" o sin "www".
# Con el error `redirect_uri_mismatch`.
#
# El valor debe ser EXACTAMENTE el mismo que pongas en "URI de redirección
# autorizada" de Google Cloud Console, incluida la barra final si la pones.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
